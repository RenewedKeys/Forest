+    }
+
+    // One-time move of markers left in old bin\<sha> folders into the state folder.
+    public static void MigrateLegacyMarkers()
+    {
+        try
+        {
+            var bin = Path.Combine(
+                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                "Forest", "bin");
+            if (!Directory.Exists(bin)) return;
+            var state = SharedStateDir();
+            int moved = 0, skipped = 0;
+            foreach (var sub in Directory.GetDirectories(bin))
+                foreach (var file in Directory.GetFiles(sub))
+                {
+                    var name = Path.GetFileName(file);
+                    if (!Array.Exists(MarkerPrefixes, p => name.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
+                        continue;
+                    var dst = Path.Combine(state, name);
+                    try
+                    {
+                        if (File.Exists(dst)) { skipped++; try { File.Delete(file); } catch { } }
+                        else { File.Move(file, dst); moved++; }
+                    }
+                    catch { skipped++; }
+                }
+            if (moved > 0 || skipped > 0)
+                DiagLog.Log($"NativeAssets: legacy-marker migration -> {state} moved={moved} skipped={skipped}");
+        }
+        catch (Exception ex)
+        {
+            try { DiagLog.Log("NativeAssets: legacy-marker migration failed: " + ex.Message); } catch { }
+        }
+    }
