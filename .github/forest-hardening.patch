+// ---- Post-connect screens Forest doesn't drive (updates etc.) --------------
+// After Connect, PlayOnline sometimes shows a screen the navigator doesn't
+// know: most often the PlayOnline Viewer or FINAL FANTASY XI version-update
+// prompt and download. Terminating pol.exe there cancels the update (and the
+// 60s late-stash would keep its dialog off-screen), so instead every window
+// of this process is brought back on screen and left for the user to finish.
+
+struct RevealCtx { int n; bool raiseAll; };
+
+static BOOL CALLBACK RevealEnumCb(HWND h, LPARAM lp)
+{
+    auto* ctx = (RevealCtx*)lp;
+    DWORD pid = 0; GetWindowThreadProcessId(h, &pid);
+    if (pid != GetCurrentProcessId()) return TRUE;
+    if (GetWindowLongA(h, GWL_STYLE) & WS_CHILD) return TRUE;
+    if (!IsWindowVisible(h)) return TRUE;
+    RECT r{}; GetWindowRect(h, &r);
+    char cls[64] = {0}; GetClassNameA(h, cls, sizeof(cls));
+    char ttl[96] = {0}; GetWindowTextA(h, ttl, sizeof(ttl));
+    int vx = GetSystemMetrics(SM_XVIRTUALSCREEN), vy = GetSystemMetrics(SM_YVIRTUALSCREEN);
+    bool offscreen = (r.left <= -30000 || r.top <= -30000);
+    // EarlyStash also made POL's windows fully transparent (layered, alpha 0).
+    LONG ex = GetWindowLongA(h, GWL_EXSTYLE);
+    bool transparent = false;
+    if (ex & WS_EX_LAYERED) {
+        BYTE alpha = 255; DWORD lwa = 0;
+        if (GetLayeredWindowAttributes(h, nullptr, &alpha, &lwa) && (lwa & LWA_ALPHA) && alpha < 255)
+            transparent = true;
+    }
+    if (!offscreen && !transparent && !ctx->raiseAll) return TRUE;   // already visible; don't keep raising it
+    if (transparent) {
+        SetLayeredWindowAttributes(h, 0, 255, LWA_ALPHA);
+        SetWindowLongA(h, GWL_EXSTYLE, ex & ~WS_EX_LAYERED);
+        RedrawWindow(h, nullptr, nullptr, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN);
+    }
+    if (offscreen) {
+        int pw = GetSystemMetrics(SM_CXSCREEN), ph = GetSystemMetrics(SM_CYSCREEN);
+        int w = r.right - r.left, hgt = r.bottom - r.top;
+        int x = (pw - w) / 2, y = (ph - hgt) / 2;
+        if (x < vx) x = vx + 60;
+        if (y < vy) y = vy + 60;
+        SetWindowPos(h, nullptr, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+    // Raise above other windows without stealing keyboard focus.
+    SetWindowPos(h, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+    SetWindowPos(h, HWND_NOTOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+    FLASHWINFO fw{ sizeof(fw), h, FLASHW_ALL | FLASHW_TIMERNOFG, 5, 0 };
+    FlashWindowEx(&fw);
+    ++ctx->n;
+    Log("REVEAL: hwnd=0x%p class=[%s] title=[%s] was at %ld,%ld%s", h, cls, ttl, r.left, r.top,
+        transparent ? " (was transparent; opacity restored)" : "");
+    return TRUE;
+}
+
+static int RevealPolWindows(bool raiseAll)
+{
+    if (g_dryRun) return 0;
+    g_hideEnabled = false;
+    g_winEvLateActive = false;     // stop stashing new dialogs
+    if (g_winEvHook) { UnhookWinEvent(g_winEvHook); g_winEvHook = nullptr; }
+    RevealCtx ctx{ 0, raiseAll };
+    EnumWindows(RevealEnumCb, (LPARAM)&ctx);
+    return ctx.n;
+}
