+    // bgres_) live here instead of next to Trees.dll, so rebuilding Forest (which
+    // changes the bin\<sha> folder) no longer orphans characters that are still
+    // running. Ported from upstream v1.2.14.
+    private static readonly string[] MarkerPrefixes =
+        { "status_", "slot_", "nohide_", "autoenter_", "bgres_", "cred_", "totp_", "cred_src_", "totp_src_" };
