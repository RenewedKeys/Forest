index 0000000..b134c55
--- /dev/null
+++ b/ui/Core/DesktopShortcut.cs
@@ -0,0 +1,71 @@
+using System.Diagnostics;
+using System.IO;
+using System.Reflection;
+using System.Text;
+
+namespace Forest;
+
+// "Create Desktop Shortcut" in the Edit Account dialog (ported from upstream
+// v1.2.12). Makes "Forest - <account>.lnk" on the desktop that starts Forest
+// with --launch "<account>" --quit-when-loaded, marked Run as administrator.
+public static class DesktopShortcut
+{
+    public sealed record Result(bool Ok, string? Path, string? Error);
+
+    public static Result CreateForProfile(string profile)
+    {
+        try
+        {
+            var exe = Process.GetCurrentProcess().MainModule?.FileName
+                      ?? Assembly.GetExecutingAssembly().Location;
+            if (string.IsNullOrEmpty(exe) || !File.Exists(exe))
+                return new Result(false, null, "Forest.exe path could not be resolved");
+
+            var desktop = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
+            var lnk = System.IO.Path.Combine(desktop, $"Forest - {MakeSafeFileName(profile)}.lnk");
+
+            var shellType = Type.GetTypeFromProgID("WScript.Shell");
+            if (shellType == null)
+                return new Result(false, null, "WScript.Shell not available on this system");
+
+            dynamic shell = Activator.CreateInstance(shellType)!;
+            dynamic sc = shell.CreateShortcut(lnk);
+            sc.TargetPath = exe;
+            sc.Arguments = $"--launch \"{profile}\" --quit-when-loaded";
+            sc.WorkingDirectory = System.IO.Path.GetDirectoryName(exe) ?? "";
+            sc.IconLocation = exe + ",0";
+            sc.Description = $"Launch {profile} via Forest";
+            sc.Save();
+
+            // Set the shell link's "Run as administrator" flag (LinkFlags
+            // RunAsUser, bit 0x20 of byte 0x15), since Forest needs admin.
+            try
+            {
+                var bytes = File.ReadAllBytes(lnk);
+                if (bytes.Length > 21)
+                {
+                    bytes[21] |= 0x20;
+                    File.WriteAllBytes(lnk, bytes);
+                }
+            }
+            catch (Exception ex)
+            {
+                return new Result(true, lnk, "shortcut created but Run-as-Admin flag failed: " + ex.Message);
+            }
+            return new Result(true, lnk, null);
+        }
+        catch (Exception ex)
+        {
+            return new Result(false, null, ex.Message);
+        }
+    }
+
+    private static string MakeSafeFileName(string s)
+    {
+        var invalid = System.IO.Path.GetInvalidFileNameChars();
+        var sb = new StringBuilder(s.Length);
+        foreach (var c in s) sb.Append(Array.IndexOf(invalid, c) >= 0 ? '_' : c);
+        var r = sb.ToString().Trim();
+        return string.IsNullOrEmpty(r) ? "Account" : r;
+    }
+}
