     public static string GetBackupDir() => BackupDir;
 
+    // ── login_w.bin lock gate + auto-restore (ported from upstream v1.2.13) ──
+
+    // True when some pol.exe still has a login_w.bin open.
+    public static bool IsAnyLoginBinLocked(Config cfg)
+    {
+        foreach (var c in DiscoverPaths(cfg))
+        {
+            if (!File.Exists(c.Path)) continue;
+            try { using (new FileStream(c.Path, FileMode.Open, FileAccess.Read, FileShare.None)) { } }
+            catch (IOException) { return true; }
+            catch (UnauthorizedAccessException) { return true; }
+            catch { }
+        }
+        return false;
+    }
+
+    // Waits (up to maxSeconds) until no pol.exe holds login_w.bin open, so the
+    // next launch can't race the previous one writing it. Returns ms waited.
+    public static int WaitForLoginBinFree(Config cfg, Action<string> log, int maxSeconds)
+    {
+        if (maxSeconds <= 0) return 0;
+        var start = DateTime.UtcNow;
+        var deadline = start.AddSeconds(maxSeconds);
+        bool announced = false;
+        while (DateTime.UtcNow < deadline)
+        {
+            if (!IsAnyLoginBinLocked(cfg))
+            {
+                int waited = (int)(DateTime.UtcNow - start).TotalMilliseconds;
+                if (announced) log($"POL-LOGINBIN: gate cleared after {waited}ms");
+                return waited;
+            }
+            if (!announced)
+            {
+                log("POL-LOGINBIN: gate holding next launch, a pol.exe still has login_w.bin open");
+                announced = true;
+            }
+            Thread.Sleep(200);
+        }
+        log($"POL-LOGINBIN: gate TIMEOUT after {maxSeconds}s (file still locked). Proceeding anyway; a pol.exe may have crashed holding the file.");
+        return maxSeconds * 1000;
+    }
+
+    // If no POL is running and a login_w.bin looks corrupt (under 1 KB),
+    // restores it from the newest good backup.
+    public static void AutoRestoreIfCorrupt(Config cfg, Action<string> log)
+    {
+        if (!cfg.LoginBinBackupEnabled || !Directory.Exists(BackupDir)) return;
+
+        var running = Process.GetProcessesByName("pol");
+        bool anyRunning = running.Length != 0;
+        foreach (var pr in running) { try { pr.Dispose(); } catch { } }
+        if (anyRunning) return;
+
+        foreach (var c in DiscoverPaths(cfg))
+        {
+            if (!File.Exists(c.Path)) continue;
+            long size;
+            try { size = new FileInfo(c.Path).Length; }
+            catch { continue; }
+            if (size >= 1024) continue;
+
+            var hash = ShortHash(c.Path);
+            var best = new DirectoryInfo(BackupDir).GetFiles($"login_w__{hash}__*.bin")
+                .Where(f => !f.Name.Contains("__pre-restore", StringComparison.Ordinal))
+                .OrderByDescending(f => f.LastWriteTimeUtc)
+                .FirstOrDefault();
+            if (best == null || best.Length < 1024)
+            {
+                log($"POL-LOGINBIN: {c.Path} is {size} bytes (corrupt suspect) but no valid backup found. Leaving untouched.");
+                continue;
+            }
+            var r = Restore(cfg, best.FullName, c.Path);
+            if (r.Ok)
+                log($"POL-LOGINBIN: auto-restored {c.Path} from {best.Name} (was {size} bytes, backup {best.Length} bytes). Emergency snapshot: {r.EmergencyBackupPath}");
+            else
+                log($"POL-LOGINBIN: auto-restore FAILED for {c.Path}: {r.Error}");
+        }
+    }
+
     public sealed record BackupEntry(string BackupPath, string TargetPath, string TargetSource, DateTime CreatedUtc, long SizeBytes, bool IsPreRestoreEmergency);
 
